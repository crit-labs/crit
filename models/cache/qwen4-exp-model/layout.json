{
  "schema": "crit-model-layout-v1",
  "gguf": {"qwen4exp": {
    "parts": {"attn_qkv": "linear_attn.in_proj_qkv", "attn_gate": "linear_attn.in_proj_z",
              "ssm_alpha": "linear_attn.in_proj_a", "ssm_beta": "linear_attn.in_proj_b", "ssm_a": "linear_attn.A_log",
              "ssm_conv1d": "linear_attn.conv1d", "ssm_dt.bias": "linear_attn.dt_bias", "ssm_dt": "linear_attn.dt_bias",
              "ssm_norm": "linear_attn.norm", "ssm_out": "linear_attn.out_proj",
              "hc_attn_down": "attn_hyper_connection.input_mix_weight_down",
              "hc_attn_up": "attn_hyper_connection.input_mix_weight_up",
              "hc_attn_inject": "attn_hyper_connection.block_inject_weight",
              "hc_attn_norm": "attn_hyper_connection.hc_norm",
              "hc_ffn_down": "mlp_hyper_connection.input_mix_weight_down",
              "hc_ffn_up": "mlp_hyper_connection.input_mix_weight_up",
              "hc_ffn_inject": "mlp_hyper_connection.block_inject_weight",
              "hc_ffn_norm": "mlp_hyper_connection.hc_norm",
              "ple_conv1d": "ple.conv1d", "ple_key": "ple.key_proj", "ple_value": "ple.value_proj",
              "ple_norm_key": "ple.norm_key", "ple_norm_query": "ple.norm_query", "ple_norm_conv": "ple.norm_conv",
              "indexer.q_norm": "self_attn.indexer.q_layernorm", "indexer.k_norm": "self_attn.indexer.k_layernorm"},
    "outside": {"output_hc_down.weight": "model.hyper_connection_mixer.input_mix_weight_down.weight",
                "output_hc_up.weight": "model.hyper_connection_mixer.input_mix_weight_up.weight",
                "output_hc_norm.weight": "model.hyper_connection_mixer.hc_norm.weight",
                "per_layer_token_embd.weight": "model.layers.{ple_layer_ids}.ple.ple_embedding.ngram_embedding.weight"},
    "constants": {".ple.layer_multipliers": "model.layers.{ple_layer_ids}.ple.ple_embedding.layer_multipliers",
                  ".ple.head_offsets": "model.layers.{ple_layer_ids}.ple.ple_embedding.ngram_heads_offsets",
                  ".ple.head_vocab_sizes": "model.layers.{ple_layer_ids}.ple.ple_embedding.ngram_heads_vocab_sizes"},
    "draft": {"nextn.eh_proj": "fc", "nextn.enorm": "pre_fc_norm_embedding", "nextn.hnorm": "pre_fc_norm_hidden",
              "nextn.shared_head_norm": "norm", "nextn.hc_head_norm": "hyper_connection_mixer.hc_norm",
              "nextn.hc_head_down": "hyper_connection_mixer.input_mix_weight_down",
              "nextn.hc_head_up": "hyper_connection_mixer.input_mix_weight_up"},
    "transforms": {
      "zero-centred": {"ends": ["norm.weight", ".ple.norm_key.weight", ".ple.norm_query.weight",
                                ".ple.norm_conv.weight", ".pre_fc_norm_embedding.weight",
                                ".pre_fc_norm_hidden.weight"],
                       "except": ["linear_attn.norm.weight"]},
      "negated-exp": ["linear_attn.A_log"],
      "squeezed": {"conv1d.weight": {"axis": 1, "rank": 3}, "mlp.shared_expert_gate.weight": {"axis": 0, "rank": 2}},
      "tiled-heads": {"heads": "linear_num_value_heads", "groups": "linear_num_key_heads", "tensors": {
        "linear_attn.in_proj_qkv.weight": {"unit": "linear_value_head_dim",
                                           "before": [["linear_num_key_heads", "linear_key_head_dim", 2]]},
        "linear_attn.conv1d.weight": {"unit": "linear_value_head_dim",
                                      "before": [["linear_num_key_heads", "linear_key_head_dim", 2]]},
        "linear_attn.in_proj_z.weight": {"unit": "linear_value_head_dim"},
        "linear_attn.in_proj_a.weight": {}, "linear_attn.in_proj_b.weight": {}, "linear_attn.A_log": {},
        "linear_attn.dt_bias": {},
        "linear_attn.out_proj.weight": {"unit": "linear_value_head_dim", "along": "inputs"}}},
      "joined-rows": {
        "attn_qkv_gate": {"names": ["linear_attn.in_proj_qkv", "linear_attn.in_proj_z"],
                          "rows": [["linear_num_key_heads", "linear_key_head_dim", 2],
                                   ["linear_num_value_heads", "linear_value_head_dim"]]},
        "ssm_beta_alpha": {"names": ["linear_attn.in_proj_b", "linear_attn.in_proj_a"],
                           "rows": "linear_num_value_heads"},
        "hc_attn_down_inject": {"names": ["attn_hyper_connection.input_mix_weight_down",
                                          "attn_hyper_connection.block_inject_weight"], "rows": "hc_lowrank"},
        "hc_ffn_down_inject": {"names": ["mlp_hyper_connection.input_mix_weight_down",
                                         "mlp_hyper_connection.block_inject_weight"], "rows": "hc_lowrank"}},
      "joined-columns": {"nextn.eh_proj": ["fc_embedding", "fc_hidden"]},
      "split-rows": {"self_attn.indexer.index_qk_proj": {"parts": ["indexer.q_proj", "indexer.k_proj"],
                                                         "rows": [["indexer_n_heads", "indexer_head_dim"]]}}}}},
  "norm_offset": 1.0,
  "defaults": {"norm_topk_prob": true, "hc_count": 4, "ngram_size": 3, "heads_per_ngram": 8,
               "ngram_vocab_size_base": 20000000, "ple_conv_kernel_size": 4, "seed": 1234},
  "residual": {"block": "streams"},
  "before": [{"block": "ngram-rows", "prefix": "ple.", "layers": "ple_layer_ids"}],
  "mixers": {
    "full_attention": {"block": "indexed-attention", "prefix": "self_attn.", "output_gate": "sigmoid"},
    "indexed_attention": {"block": "indexed-attention", "prefix": "self_attn.", "output_gate": "sigmoid"},
    "linear_attention": {"block": "gated-delta", "prefix": "linear_attn.", "norm_gate": "output_gate_type"}
  },
  "ffn": {"block": "auto", "prefix": "mlp."},
  "draft": {"block": "mtp", "prefix": "mtp."}
}
