    {"name": "code-python", "dataset": "codeparrot/github-code-clean", "config": "Python-all", "split": "train", "field": "code", "offset": 0, "rows": 100, "license": "per file, as the dataset records it"},
    {"name": "code-javascript", "dataset": "codeparrot/github-code-clean", "config": "JavaScript-all", "split": "train", "field": "code", "offset": 0, "rows": 100, "license": "per file, as the dataset records it"},
    {"name": "code-cpp", "dataset": "codeparrot/github-code-clean", "config": "C++-all", "split": "train", "field": "code", "offset": 0, "rows": 100, "license": "per file, as the dataset records it"}
  ],
  "held_out": [
    {"name": "web-de-test", "dataset": "HuggingFaceFW/fineweb-2", "config": "deu_Latn", "split": "test", "field": "text", "offset": 0, "rows": 50, "license": "odc-by"},
