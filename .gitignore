# Publish only these root files and complete product folders.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/CHANGELOG.md
!/LICENSE
!/pyproject.toml
!/settings.example.toml
!/core/
!/inference/
!/kernels/
!/models/
!/tests/
!/docs/
!/eval/
!/cli/
!/api/
!/.github/

# Local copies of the case-study runs (case-studies/README.md): ignored by the allowlist above, and named here so
# they stay out if it changes.
/case-studies/

# Python bytecode
__pycache__/
*.py[co]
*.egg-info/
