{
  "schema": "crit-model-technique-v1",
  "id": "block-drafter",
  "category": "drafters",
  "summary": "A drafter stored beside the checkpoint: a few bidirectional layers that fill a whole block of drafts in one pass over their own cache of the target's tapped rows, and a recurrent head that orders the block's drafts token by token, folded through the model's head",
