# Publish only these root files and complete product folders.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/CHANGELOG.md
!/LICENSE
!/pyproject.toml
!/settings.example.toml
!/core/
!/inference/
!/kernels/
!/models/
!/tests/
!/docs/
!/cli/
!/api/
!/.github/

# Python bytecode
__pycache__/
*.py[co]
*.egg-info/
