    {"name": "web-hi", "dataset": "HuggingFaceFW/fineweb-2", "config": "hin_Deva", "split": "test", "field": "text", "offset": 0, "rows": 50, "license": "odc-by"},
    {"name": "web-en-far", "dataset": "HuggingFaceFW/fineweb-edu", "config": "default", "split": "train", "field": "text", "offset": 500000, "rows": 50, "license": "odc-by"},
    {"name": "code-java", "dataset": "codeparrot/github-code-clean", "config": "Java-all", "split": "train", "field": "code", "offset": 0, "rows": 50, "license": "per file, as the dataset records it"},
    {"name": "code-python-far", "dataset": "codeparrot/github-code-clean", "config": "Python-all", "split": "train", "field": "code", "offset": 100000, "rows": 50, "license": "per file, as the dataset records it"}
