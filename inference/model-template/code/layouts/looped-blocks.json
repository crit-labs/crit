{
  "schema": "crit-model-layout-v1",
  "name": "looped-blocks",
  "description": "A decoder whose middle span of layers runs several times with the same weights (each pass its own KV and convolution windows, the later passes taking messages from the pass before), joined by attention residuals over blocks of layers; sliding-window and full layers of relative attention (a bias a token computes for the positions just behind it, learned sinks a token, short convolutions over the keys and values, L2-clipped queries and keys, a gated output) with short convolutions after the attention and after the FFN, experts routed by sigmoid scores with a correction bias whose SwiGLU caps its linear gate and its up projection, a normed embedding, a head of fewer rows than its stored ones and capped logits",
  "model_types": ["inkling2_loop", "inkling2_loop_text"],
  "norm_offset": 0.0,
  "logit_softcap": "final_logit_softcapping",
  "head_rows": "unpadded_vocab_size",
  "expert_caps": ["mlp_gate_softcap", "mlp_up_softcap"],
  "defaults": {"scoring_func": "sigmoid", "norm_topk_prob": true, "n_layers_per_attn_res_block": 6,
               "log_scaling_alpha": 0.1, "log_scaling_n_floor": 8192, "mlp_gate_softcap": 4.0, "mlp_up_softcap": 25.0,
               "final_logit_softcapping": 30.0},
  "residual": {"block": "block-attention"},
  "mixers": {
    "sliding_attention": {"block": "relative-attention", "prefix": "self_attn.", "heads": "swa_num_attention_heads",
                          "kv_heads": "swa_num_key_value_heads", "head_dim": "swa_head_dim",
                          "post": {"attention": "post_attention_convolution.", "ffn": "post_mlp_convolution."}},
    "full_attention": {"block": "relative-attention", "prefix": "self_attn.", "log_scaling": true,
                       "post": {"attention": "post_attention_convolution.", "ffn": "post_mlp_convolution."}}
  },
  "ffn": {"block": "auto", "prefix": "mlp.", "gate_up": "interleaved", "weights": "fp32"},
  "draft": {"block": "mtp", "prefix": "mtp."},
  "names": [
    ["^(?!model\\.)", "mtp."],
    ["^model\\.llm\\.unembed\\.", "lm_head."],
    ["^model\\.llm\\.", "model.language_model."],
    ["\\.embed\\.weight$", ".embed_tokens.weight"],
    ["\\.embed_norm\\.", ".embed_tokens.embed_norm."],
    ["mlp\\.experts\\.w13_", "mlp.experts.gate_up_proj."],
    ["mlp\\.experts\\.w2_", "mlp.experts.down_proj."],
    ["mlp\\.gate\\.bias$", "mlp.gate.e_score_correction_bias"],
    ["\\.controllers\\.attn\\.", ".q_message_gate."],
    ["\\.controllers\\.(k|v|mlp)\\.", ".\\1_message_gate."],
    ["_message_gate\\.down_weight$", "_message_gate.down_proj.weight"],
    ["_message_gate\\.gain_weight$", "_message_gate.message_gate_proj.weight"],
    ["_message_gate\\.forget_weight$", "_message_gate.forget_gate_proj.weight"],
    ["\\.attn\\.", ".self_attn."],
    ["self_attn\\.wq_du\\.", "self_attn.q_proj.linear."],
    ["self_attn\\.wk_dv\\.", "self_attn.k_proj.linear."],
    ["self_attn\\.wv_dv\\.", "self_attn.v_proj.linear."],
    ["self_attn\\.(k|v)_sconv\\.", "self_attn.\\1_proj.sconv."],
    ["self_attn\\.rel_logits_proj\\.", "self_attn.relative_position_bias."],
    ["self_attn\\.wr_du\\.", "self_attn.relative_position_bias.linear."],
    ["self_attn\\.q_l2_clip\\.", "self_attn.q_proj.norm."],
    ["self_attn\\.rel_l2_clip\\.", "self_attn.relative_position_bias.norm."],
    ["self_attn\\.wo_ud\\.", "self_attn.o_proj.linear."],
    ["self_attn\\.gate_attn\\.", "self_attn.o_proj.gate_proj."],
    ["self_attn\\.attn_sink_proj\\.", "self_attn.sink_proj."],
    ["\\.attn_sconv\\.weight$", ".post_attention_convolution.conv1d.weight"],
    ["\\.mlp_sconv\\.weight$", ".post_mlp_convolution.conv1d.weight"],
    ["sconv\\.weight$", "sconv.conv1d.weight"],
    ["sconv\\.static_w$", "sconv.static_weight"],
    ["sconv\\.weight_proj$", "sconv.weight_proj.weight"],
    ["\\.mlp_norm\\.", ".post_attention_layernorm."],
    ["\\.attn_norm\\.", ".input_layernorm."],
    ["\\.(q|k|v)_input_norm\\.", ".\\1_input_layernorm."],
    ["attn_res\\.attn_queries\\.(\\d+)$", "layers.\\1.attention_input.query", 1],
    ["attn_res\\.mlp_queries\\.(\\d+)$", "layers.\\1.mlp_input.query"],
    ["attn_res\\.output_query$", "final_input.query"],
    ["middle_cycle_cross_pass_queries$", "message_input.query_mlp"],
    ["middle_cycle_cross_pass_kv_queries$", "message_input.key_value"]
  ]
}
